{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "platformAutomerge": true,
    "automergeType": "pr",
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "automerge": true
        },
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            "matchManagers": ["composer"],
            "matchDepTypes": ["require-dev"],
            "rangeStrategy": "bump"
        },
        {
            "description": "Optional integrations are tested against their minimal versions: never raise the lower bound, only widen for new majors",
            "matchManagers": ["composer"],
            "matchPackageNames": [
                "imagine/imagine",
                "kornrunner/blurhash",
                "league/flysystem-bundle",
                "league/glide",
                "league/glide-symfony",
                "psr/http-client",
                "psr/http-factory",
                "symfony/http-client",
                "symfony/twig-bundle",
                "vich/uploader-bundle"
            ],
            "rangeStrategy": "widen"
        },
        {
            "description": "Symfony runtime requirements keep their minimal versions: never raise the lower bound, only widen for new majors",
            "matchManagers": ["composer"],
            "matchDepTypes": ["require"],
            "matchPackageNames": ["symfony/**"],
            "rangeStrategy": "widen"
        }
    ]
}
